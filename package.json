{
  "name": "plataforma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "description": "Plataforma SaaS Multi-tenant para Creacion y Gestion Digital de Negocios",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build:hostinger",
    "build:api": "npm run build -w packages/shared && npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:hostinger": "npm run build -w packages/shared && npm run generate -w packages/database && npm run build -w apps/api",
    "lint": "turbo lint",
    "lint:api": "npm run lint -w apps/api",
    "lint:web": "npm run lint -w apps/web",
    "db:generate": "npm run generate -w packages/database",
    "db:migrate": "npm run migrate -w packages/database",
    "db:push": "npm run push -w packages/database",
    "db:studio": "npm run studio -w packages/database",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "clean": "rimraf -g apps/*/.next apps/*/dist apps/*/.turbo node_modules/.cache"
  },
  "devDependencies": {
    "expo": "~54.0.0",
    "rimraf": "^5.0.10",
    "turbo": "^2.3.3",
    "expo-router": "~6.0.24"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react-native-screens": "~4.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}