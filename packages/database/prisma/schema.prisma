generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  avatarUrl       String?  @map("avatar_url")
  phone           String?
  isActive        Boolean  @default(true) @map("is_active")
  isVerified      Boolean  @default(false) @map("is_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?  @map("last_login_ip")
  locale          String   @default("es")
  timezone        String   @default("America/Guayaquil")
  googleId        String?  @unique @map("google_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  pushTokens      PushToken[]
  userTenants     UserTenant[]
  auditLogs       AuditLog[]
  invitations     Invitation[]
  supportTickets  SupportTicket[]
  ticketReplies   SupportTicketReply[]

  @@index([email])
  @@index([googleId])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique @db.VarChar(1000)
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(191)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  device    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  subdomain       String?  @unique
  customDomain    String?  @unique @map("custom_domain")
  logoUrl         String?  @map("logo_url")
  faviconUrl      String?  @map("favicon_url")
  primaryColor    String?  @default("#2563EB") @map("primary_color")
  secondaryColor  String?  @default("#1E40AF") @map("secondary_color")
  isActive        Boolean  @default(true) @map("is_active")
  planId          String?  @map("plan_id")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  maxUsers        Int      @default(3)
  maxSites        Int      @default(1)
  maxStorage      BigInt   @default(52428800)
  storageUsed     BigInt   @default(0) @map("storage_used")
  settings        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  plan           Plan?     @relation(fields: [planId], references: [id])
  userTenants    UserTenant[]
  sites          Site[]
  leads          Lead[]
  auditLogs      AuditLog[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  media          Media[]
  forms          Form[]
  analyticsEvents AnalyticsEvent[]
  webhookConfigs WebhookConfig[]
  apiKeys        ApiKey[]
  reviews         Review[]
  automations    Automation[]
  productCategories ProductCategory[]
  products          Product[]
  coupons           Coupon[]
  orders            Order[]
  bookingServices   BookingService[]
  bookings          Booking[]
   supportTickets    SupportTicket[]
   sorteos           Sorteo[]
   linkPages         LinkPage[]

   @@index([slug])
  @@index([subdomain])
  @@index([isActive, deletedAt])
  @@map("tenants")
}

model UserTenant {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tenantId    String   @map("tenant_id")
  isOwner     Boolean  @default(false) @map("is_owner")
  joinedAt    DateTime @default(now()) @map("joined_at")
  invitedBy   String?  @map("invited_by")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  UserTenantRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  level       String   @default("tenant")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions    RolePermission[]
  userTenantRoles UserTenantRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserTenantRole {
  userTenantId String @map("user_tenant_id")
  roleId       String @map("role_id")

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userTenantId, roleId])
  @@map("user_tenant_roles")
}

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  price           Decimal  @default(0)
  currency        String   @default("USD")
  billingInterval String   @default("monthly") @map("billing_interval")
  maxUsers        Int      @default(1)
  maxSites        Int      @default(1)
  maxStorage      BigInt   @default(52428800)
  features        Json?
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  planId          String    @map("plan_id")
  status          String    @default("active")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  canceledAt      DateTime? @map("canceled_at")
  endedAt         DateTime? @map("ended_at")
  paymentMethod   String?   @map("payment_method")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
  invoices  Invoice[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  subscriptionId  String   @map("subscription_id")
  amount          Decimal
  currency        String   @default("USD")
  status          String   @default("pending")
  paidAt          DateTime? @map("paid_at")
  externalId      String?  @map("external_id")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("invoices")
}

model Site {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  domain       String?  @unique
  subdomain    String?  @unique
  isPublished  Boolean  @default(false) @map("is_published")
  templateId   String?  @map("template_id")
  primaryColor String?  @default("#2563EB") @map("primary_color")
  faviconUrl   String?  @map("favicon_url")
  logoUrl      String?  @map("logo_url")
  seoTitle     String?  @map("seo_title")
  seoDesc      String?  @map("seo_desc")
  settings     Json?
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template        Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pages           SitePage[]
  reviews         Review[]
  forms           Form[]
  analyticsEvents AnalyticsEvent[]

  @@index([tenantId])
  @@map("sites")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  thumbnail   String?
  categoryId  String?  @map("category_id")
  tags        Json?
  isActive    Boolean  @default(true) @map("is_active")
  isPremium   Boolean  @default(false) @map("is_premium")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category     TemplateCategory? @relation(fields: [categoryId], references: [id])
  pages        TemplatePage[]
  globalStyles Json?             @map("global_styles")
  sites        Site[]

  @@map("templates")
}

model TemplateCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  templates Template[]

  @@map("template_categories")
}

model TemplatePage {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  name       String
  slug       String
  path       String   @default("/")
  isDefault  Boolean  @default(false) @map("is_default")
  seoTitle   String?  @map("seo_title")
  seoDesc    String?  @map("seo_desc")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  template Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  blocks   TemplateBlock[]

  @@unique([templateId, slug])
  @@map("template_pages")
}

model TemplateBlock {
  id             String @id @default(uuid())
  templatePageId String @map("template_page_id")
  type           String
  content        Json
  styles         Json?
  sortOrder      Int    @default(0) @map("sort_order")

  page TemplatePage @relation(fields: [templatePageId], references: [id], onDelete: Cascade)

  @@map("template_blocks")
}

model SitePage {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  name       String
  slug       String
  path       String   @default("/")
  isDefault  Boolean  @default(false) @map("is_default")
  seoTitle   String?  @map("seo_title")
  seoDesc    String?  @map("seo_desc")
  sortOrder  Int      @default(0) @map("sort_order")
  isPublished Boolean @default(false) @map("is_published")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blocks PageBlock[]

  @@unique([siteId, slug])
  @@map("site_pages")
}

model PageBlock {
  id         String @id @default(uuid())
  sitePageId String @map("site_page_id")
  type       String
  content    Json
  styles     Json?
  sortOrder  Int    @default(0) @map("sort_order")

  page SitePage @relation(fields: [sitePageId], references: [id], onDelete: Cascade)

  @@map("page_blocks")
}

model Form {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  siteId      String?  @map("site_id")
  name        String
  type        String   @default("contact")
  fields      Json
  settings    Json?
  buttonText  String?  @default("Enviar") @map("button_text")
  redirectUrl String?  @map("redirect_url")
  emailNotify String?  @map("email_notify")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@index([tenantId])
  @@index([siteId])
  @@map("forms")
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  data      Json
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  leadId    String?  @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@map("form_submissions")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  siteId    String?  @map("site_id")
  type      String
  path      String?
  referrer  String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([tenantId, type, createdAt])
  @@index([siteId, createdAt])
  @@map("analytics_events")
}

model Media {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  originalName String   @map("original_name")
  storedName   String   @map("stored_name")
  mimeType     String   @map("mime_type")
  size         BigInt
  url          String
  width        Int?
  height       Int?
  folder       String?  @default("/")
  alt          String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, folder])
  @@map("media")
}

model Lead {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  siteId    String?  @map("site_id")
  formId    String?  @map("form_id")
  email     String?
  phone     String?
  name      String?
  data      Json?
  status    String   @default("new")
  source    String?  @map("source")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  tenantId  String?  @map("tenant_id")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([action, resource])
  @@map("audit_logs")
}

model Invitation {
  id        String    @id @default(uuid())
  email     String
  tenantId  String    @map("tenant_id")
  roleId    String    @map("role_id")
  token     String    @unique
  status    String    @default("pending")
  invitedBy String    @map("invited_by")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  inviter User @relation(fields: [invitedBy], references: [id])

  @@index([token])
  @@index([email, status])
  @@index([tenantId])
  @@map("invitations")
}

model WebhookConfig {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  url       String
  events    Json
  secret    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_configs")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String   @map("webhook_id")
  event      String
  payload    Json
  status     String   @default("pending")
  statusCode Int?     @map("status_code")
  response   String?  @db.Text
  attempts   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  webhook WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  name       String
  key        String    @unique @db.VarChar(200)
  prefix     String
  scopes     Json?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([key])
  @@map("api_keys")
}

model Automation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  trigger    String
  triggerConfig Json?
  action     String
  actionConfig  Json?
  isActive   Boolean  @default(true) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  runCount   Int      @default(0) @map("run_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("automations")
}

model ProductCategory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  slug      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  categoryId  String?  @map("category_id")
  name        String
  slug        String
  description String?  @db.Text
  price       Decimal
  comparePrice Decimal? @map("compare_price")
  currency    String   @default("USD")
  sku         String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  images      Json?
  variants    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, categoryId])
  @@map("products")
}

model Coupon {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  code         String
  type         String   @default("percentage")
  value        Decimal
  minAmount    Decimal?  @map("min_amount")
  maxUses      Int?     @map("max_uses")
  usedCount    Int      @default(0) @map("used_count")
  startsAt     DateTime? @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  status      String   @default("pending")
  totalAmount Decimal  @map("total_amount")
  currency    String   @default("USD")
  customerName String? @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")
  notes       String?  @db.Text
  couponCode  String?  @map("coupon_code")
  discount    Decimal  @default(0)
  paymentMethod String? @map("payment_method")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  price     Decimal
  total     Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model BookingService {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  duration    Int      @default(30)
  price       Decimal  @default(0)
  color       String   @default("#2563EB")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@map("booking_services")
}

model Booking {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  serviceId  String   @map("service_id")
  customerName String @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  status     String   @default("confirmed")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startTime])
  @@index([serviceId, startTime])
  @@map("bookings")
}

model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  subject     String
  description String   @db.Text
  priority    String   @default("low")
  status      String   @default("open")
  category    String   @default("general")
  assignedTo  String?  @map("assigned_to")
  images      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  closedAt    DateTime? @map("closed_at")

  tenant  Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies SupportTicketReply[]

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  message   String   @db.Text
  images    Json?
  isStaff   Boolean  @default(false) @map("is_staff")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_replies")
}

model Review {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  siteId      String?  @map("site_id")
  authorName  String   @map("author_name")
  authorEmail String?  @map("author_email")
  rating      Int      @default(5)
  content     String   @db.Text
  avatarUrl   String?  @map("avatar_url")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isPublished, createdAt])
  @@index([siteId])
  @@map("reviews")
}

model Sorteo {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  title       String
  slug        String
  description String?  @db.Text
  fields      Json     @default("[]")
  background  Json?
  isActive    Boolean  @default(true) @map("is_active")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants SorteoParticipant[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("sorteos")
}

model SorteoParticipant {
  id          String   @id @default(uuid())
  sorteoId    String   @map("sorteo_id")
  tenantId    String   @map("tenant_id")
  data        Json
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  sorteo Sorteo @relation(fields: [sorteoId], references: [id], onDelete: Cascade)

  @@index([sorteoId])
  @@index([sorteoId, createdAt])
  @@map("sorteo_participants")
}




model LinkPage {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  title       String
  slug        String
  description String?  @db.Text
  logoUrl     String?  @map("logo_url")
  background  Json?
  socials     Json?
  links       Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("link_pages")
}
