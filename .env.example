# Entorno
NODE_ENV=development
PORT=3001
SEED_ON_STARTUP=true

# Base de Datos
DATABASE_URL=mysql://root:password@mysql:3306/plataforma
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=plataforma
DATABASE_RETRY_ON_STARTUP=true
DATABASE_RETRY_INTERVAL_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CSRF_SECRET=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@plataforma.com

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
STORAGE_MAX_FILE_SIZE=10485760

# CDN
CDN_URL=

# Payphone
PAYPHONE_APP_ID=
PAYPHONE_TOKEN=

# Vercel (dominios personalizados automáticos)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_ksOJayvuXl3yBIJFCaV9IFK7i7Yh

# WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000
